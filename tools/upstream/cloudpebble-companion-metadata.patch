@@ -0,0 +1,68 @@
+"""Pure manifest round-trip tests; no database or Django setup required."""
+import ast
+import json
+from pathlib import Path
+import re
+from types import SimpleNamespace
+import unittest
+import uuid
+
+SOURCE = Path(__file__).resolve().parents[1] / 'utils/sdk/manifest.py'
+
+
+def manifest_functions():
+    names = {'load_manifest_dict', 'generate_v3_manifest_dict',
+             'generate_v2_manifest_dict', 'dict_to_pretty_json'}
+    tree = ast.parse(SOURCE.read_text())
+    tree.body = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name in names]
+    scope = dict(json=json, re=re, uuid=uuid, APPINFO_MANIFEST='appinfo.json',
+                 PACKAGE_MANIFEST='package.json', InvalidProjectArchiveException=ValueError,
+                 regexes=SimpleNamespace(uuid=r'^[0-9a-f-]{36}$'),
+                 generate_resource_dict=lambda project, resources: {'media': []},
+                 _=lambda value: value)
+    exec(compile(tree, str(SOURCE), 'exec'), scope)
+    return scope
+
+
+class CompanionManifestTests(unittest.TestCase):
+    def setUp(self):
+        self.functions = manifest_functions()
+        self.companion = {'android': {'url': 'https://example.org/download',
+                                      'apps': [{'package': 'dev.example.companion'}]}}
+        self.manifest = {'name': 'example', 'author': 'example', 'version': '1.0.0',
+                         'pebble': {'uuid': '7d07aa22-7d13-48c1-a400-2602a5ae4647',
+                                    'companionApp': self.companion}}
+
+    def roundtrip(self, manifest, kind):
+        settings, _, _ = self.functions['load_manifest_dict'](manifest, kind)
+        settings.setdefault('app_companion', {})
+        project = SimpleNamespace(**settings)
+        project.npm_name = 'example'
+        project.semver = '1.0.0'
+        project.keywords = []
+        project.get_dependencies = lambda: {}
+        project.app_platforms = 'emery'
+        project.app_platform_list = ['emery']
+        project.app_version_label = '1.0'
+        return self.functions['generate_v3_manifest_dict'](project, [])
+
+    def test_package_import_build_preserves_companion(self):
+        self.assertEqual(self.roundtrip(self.manifest, 'package.json')['pebble']['companionApp'], self.companion)
+
+    def test_legacy_import_build_preserves_companion(self):
+        manifest = dict(uuid=self.manifest['pebble']['uuid'], shortName='test', longName='test',
+                        companyName='test', versionLabel='1.0', companionApp=self.companion)
+        self.assertEqual(self.roundtrip(manifest, 'appinfo.json')['pebble']['companionApp'], self.companion)
+
+    def test_absent_companion_stays_absent(self):
+        del self.manifest['pebble']['companionApp']
+        self.assertNotIn('companionApp', self.roundtrip(self.manifest, 'package.json')['pebble'])
+
+    def test_invalid_companion_rejected(self):
+        self.manifest['pebble']['companionApp'] = []
+        with self.assertRaises(ValueError):
+            self.roundtrip(self.manifest, 'package.json')
+
+
+if __name__ == '__main__':
+    unittest.main()
